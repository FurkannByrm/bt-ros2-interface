<root BTCPP_format="4">
  <BehaviorTree ID="MainTask">
    <Sequence>
      <!-- Sensing: Start & Step 1 -->
      <WaitForSignal topic="/ros2_comm/sensing/carbody_located_status" expected_value="true" timeout="200.0"/>
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos1" request_payload="true" timeout="10.0"/>
      <WaitForSignal topic="/ros2_comm/sensing/is_operation1_finished" expected_value="true" timeout="200.0"/>

      <!-- Sensing: Step 2 -->
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos2" request_payload="true" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/sensing/t_go_slider_pos2" request_payload="true" timeout="10.0"/>
      <WaitForSignal topic="/ros2_comm/sensing/is_operation2_finished" expected_value="true" timeout="200.0"/>

      <!-- Sensing: Step 3 -->
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos3" request_payload="true" timeout="10.0"/>
      <WaitForSignal topic="/ros2_comm/sensing/is_operation3_finished" expected_value="true" timeout="200.0"/>

      <!-- Sensing: Step 4 -->
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos4" request_payload="true" timeout="10.0"/>
      <WaitForSignal topic="/ros2_comm/sensing/is_operation4_finished" expected_value="true" timeout="200.0"/>

      <!-- Sensing: Step 5 & 6 -->
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos5" request_payload="true" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos6" request_payload="true" timeout="10.0"/>

      <!-- Cleaning: Trigger & Set True -->
      <WaitForSignal topic="/ros2_comm/cleaning/carbody_located_status" expected_value="true" timeout="200.0"/>
      <ClientReq topic="/ros2_comm/cleaning/cleaning_finished_set" request_payload="true" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/cleaning/pos2_set" request_payload="true" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/cleaning/pos3_set" request_payload="true" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/cleaning/pos4_set" request_payload="true" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/cleaning/pos5_set" request_payload="true" timeout="10.0"/>

      <!-- Cleaning: Reset (Set False) -->
      <WaitForSignal topic="/ros2_comm/cleaning/carbody_located_status" expected_value="false" timeout="200.0"/>
    
      <ClientReq topic="/ros2_comm/cleaning/go_slider_pos1" request_payload="true" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/cleaning/go_slider_pos2" request_payload="true" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/cleaning/go_slider_pos3" request_payload="true" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/cleaning/go_slider_pos4" request_payload="true" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/cleaning/go_slider_pos5" request_payload="true" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/cleaning/go_slider_pos6" request_payload="true" timeout="10.0"/>

      <!-- Sensing: Reset (Set False) -->
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos1" request_payload="false" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos2" request_payload="false" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/sensing/t_go_slider_pos2" request_payload="false" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos3" request_payload="false" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos4" request_payload="false" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos5" request_payload="false" timeout="10.0"/>
      <ClientReq topic="/ros2_comm/sensing/go_slider_pos6" request_payload="false" timeout="10.0"/>
    </Sequence>
  </BehaviorTree>
</root>
